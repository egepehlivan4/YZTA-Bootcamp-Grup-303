# FloraGuard — Ortam Değişkenleri Şablonu
# Kopyalayıp `.env` olarak kaydedin ve gerçek değerlerle doldurun.
# `.env` dosyasını ASLA commit etmeyin (bkz. .gitignore).

ENVIRONMENT=development

# --- LLM / Orkestratör Ajan (Groq Altyapısı) ---
# Groq API anahtarını https://console.groq.com adresinden alabilirsiniz:
GROQ_API_KEY=gsk_BURAYA_GERCEK_ANAHTARINIZI_YAPISTIRIN
# Tool-calling için en başarılı olan Llama 3.3 70B modelini seçebilirsiniz:
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3

# --- Ensemble ağırlıkları (toplamı 1.0 olmalı) ---
ENSEMBLE_W_CNN=0.55
ENSEMBLE_W_LSTM=0.45

# --- Güvenlik (JWT) ---
# Üretimde MUTLAKA rastgele, uzun bir değerle değiştirin: `openssl rand -hex 32`
JWT_SECRET_KEY=BURAYA_RASTGELE_UZUN_BIR_DEGER_KOYUN
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Frontend'in backend'i bulması için ---
FLORAGUARD_API_URL=http://localhost:8000

# --- Hava Durumu API (opsiyonel) ---
# Tanımlı değilse deterministik sentetik hava serisi kullanılır.
# https://openweathermap.org/api adresinden ücretsiz anahtar alınabilir.
OPENWEATHER_API_KEY=
